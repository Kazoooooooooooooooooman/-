{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--executable-path",
        "/opt/pw-browsers/chromium"
      ]
    },
    "perplexity-docs": {
      "type": "http",
      "url": "https://docs.perplexity.ai/mcp"
    }
  }
}